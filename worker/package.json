{
  "name": "fti-reminders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that sends scheduled Web Push reminders for FixThisInjustice.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
