# dependencies and build output
node_modules/
dist/
dev-dist/
coverage/
.vite/

# environment
.env
.env.*
!.env.example
# The Worker's local secrets: VAPID_PRIVATE_JWK among them. Already covered by
# worker/.gitignore line 3; repeated here so the secret stays untracked if that file is ever
# moved or the worker package is restructured.
worker/.dev.vars

# tooling caches and local editor state
graphify-out/cache/
.nodeterm/
.design-canvas.state.json

# working directories that are not part of the deployed artifact
uploads/
screenshots/

# Local agy (Gemini CLI) permissions, scoped to this repo. Tool config, not project source.
.gemini/

# Python bytecode from local asset tooling
__pycache__/
