{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "build/cspPlugin.ts", "build/buildInfo.ts", "build/buildInfo.test.ts", "build/distFingerprint.test.ts", "build/workflows.test.ts", "build/sfxManifest.ts", "build/sfxManifest.test.ts", "build/cspPlugin.test.ts", "build/designPatch.test.ts", "src/config/videoInstances.ts"]
}
